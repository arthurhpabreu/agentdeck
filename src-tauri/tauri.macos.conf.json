{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agentdeck",
        "width": 360,
        "height": 220,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
