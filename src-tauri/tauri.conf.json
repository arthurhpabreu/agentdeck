{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentdeck",
  "version": "0.6.4",
  "identifier": "com.tuxao.agentdeck",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agentdeck",
        "width": 360,
        "height": 220,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "publisher": "Arthur Abreu",
    "copyright": "Copyright (c) 2026 Arthur Abreu",
    "licenseFile": "../LICENSE",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "4a74fa6a-9c57-5f48-87ee-7a8ab27ee6a8"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "resources": { "../LICENSE": "LICENSE" }
  }
}
