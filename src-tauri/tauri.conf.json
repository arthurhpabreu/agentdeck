{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentdeck",
  "version": "0.8.1",
  "identifier": "com.tuxao.agentdeck",
  "build": {
    "beforeDevCommand": "node scripts/frontend.mjs dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/frontend.mjs build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agentdeck",
        "width": 360,
        "height": 220,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Arthur Abreu",
    "copyright": "Copyright (c) 2026 Arthur Abreu",
    "licenseFile": "../LICENSE",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE"
    }
  }
}
